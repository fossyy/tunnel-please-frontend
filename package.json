{
  "name": "tunel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "preview": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "check:responsive": "node scripts/responsive-check.ts",
    "check:contrast": "node scripts/contrast-check.ts",
    "check": "npm run check:responsive && npm run check:contrast"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "playwright": "^1.65.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
